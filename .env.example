# Install as .env, owner root, group gorelo-mcp, mode 0640 (see docs/INSTALL.md step 3). Never commit .env. Values are empty on purpose.

# The Gorelo API key, raw, with no "Bearer " prefix (required). The changelog watcher does not read this file: it has its own /etc/gorelo-mcp/watcher.env.
GORELO_API_KEY=

# The Gorelo API address (optional): GORELO_BASE_URL must be the host of the region your Gorelo account is hosted in. Leave blank for the US host https://api.usw.gorelo.io, or put https://api.aue.gorelo.io for an Australian tenant. https only, a host under gorelo.io; /v1 and a trailing slash are optional. The start line in the journal (gorelo-mcp settings: api_host=...) names the host the server uses: it must be that host.
GORELO_BASE_URL=

# The public HTTPS URL claude.ai reaches this server at, without /mcp or a trailing slash (required; it is the OAuth issuer).
PUBLIC_BASE_URL=

# The password on the consent page when claude.ai connects (required; any long random string).
MCP_AUTH_PASSWORD=

# Toolsets to enable: a comma list of core, tickets, time, billing, uptime, projects, forms, documents, or all (blank: core,tickets,time,billing,uptime; projects, forms and documents are off by default, and documents needs the Documents scope on the API key).
GORELO_TOOLSETS=

# 1, true, yes or on registers every gated tool: the delete and void tools, remove_document_related_item (it removes the link between a document and another record), create_approved_invoice (an Approved invoice is pushed to the connected accounting system at once and may email its recipients) and share_document (it turns on a document's public link or publishes it to the client portal, so anyone who has the link can read it); each call still needs confirm=true; blank, 0, false, no or off keeps them all off. Or give a comma list of just the gated tool names you want, for example delete_time_entry,delete_item (case does not matter; a name that is not a gated tool, or that belongs to a toolset GORELO_TOOLSETS does not enable, stops the start).
GORELO_ENABLE_DESTRUCTIVE=

# Extra domains an AI client may be sent back to after sign-in (optional), comma separated, added to claude.ai, claude.com and localhost; Microsoft Copilot Studio needs global.consent.azure-apim.net. Each entry also admits its subdomains, so add only hosts you trust: bare names with a dot, no https:// and no path. Blank adds none.
MCP_EXTRA_REDIRECT_DOMAINS=
