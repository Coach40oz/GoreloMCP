# Install as /etc/gorelo-mcp/watcher.env, owner root, mode 0600 (directory /etc/gorelo-mcp mode 0755 or 0700).
# This is everything scripts/watch_gorelo_changelog.py reads from the environment: the key, and one optional address.
# Use a Gorelo API key that can create alerts; it may be the same key as the server's, or a separate one with fewer scopes.
GORELO_API_KEY=replace-with-the-gorelo-api-key

# Optional: the Gorelo host of your region. Leave it out for the US host. For an account hosted in Australia remove the # in
# front of the next line (same rule as GORELO_BASE_URL in the server's .env: https, a host under gorelo.io, nothing else).
# GORELO_BASE_URL=https://api.aue.gorelo.io
