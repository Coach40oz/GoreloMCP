# Install as /etc/gorelo-mcp/watcher.env, owner root, mode 0600 (directory /etc/gorelo-mcp mode 0755 or 0700).
# This is everything scripts/watch_gorelo_changelog.py reads from the environment. Use a Gorelo API key that can
# create alerts; it may be the same key as the server's, or a separate one with fewer scopes.
GORELO_API_KEY=replace-with-the-gorelo-api-key
